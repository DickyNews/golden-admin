<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Dicky News Golden — Admin</title>
<style>
:root{--bg:#0b0b0b;--card:#141414;--line:#2b2b2b;--text:#f5f5f5;--muted:#9d9d9d;--yellow:#ffd21a}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,Arial,sans-serif}
main{width:min(760px,calc(100% - 28px));margin:40px auto}
.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}
h1{margin:0;font-size:27px}
.sub{color:var(--muted);font-size:13px;margin-top:5px}
.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:22px;margin-bottom:16px}
label{display:block;color:var(--muted);font-size:13px;margin-bottom:7px}
input{width:100%;padding:13px 14px;border-radius:12px;border:1px solid var(--line);background:#0f0f0f;color:var(--text);outline:none}
input:focus{border-color:var(--yellow)}
.row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
button{border:0;border-radius:12px;padding:12px 16px;font-weight:800;cursor:pointer}
.primary{background:var(--yellow);color:#111}
.secondary{background:#252525;color:#fff;border:1px solid var(--line)}
.actions{display:flex;gap:10px;margin-top:18px}
.hidden{display:none}
.status{margin-top:14px;color:var(--muted);font-size:13px}
.ok{color:#8ee28e}
.err{color:#ff7777}
.service{display:flex;justify-content:space-between;gap:15px;align-items:center}
.badge{padding:7px 10px;border-radius:999px;background:#242000;color:var(--yellow);font-size:12px;font-weight:800}
@media(max-width:600px){
.row{grid-template-columns:1fr}
.top{align-items:flex-start}
}
</style>
</head>

<body>
<main>

<div class="top">
<div>
<h1>Dicky News Golden Admin</h1>
<div class="sub">Kontrol harga, batas ukuran, dan status layanan</div>
</div>
<button class="secondary hidden" id="logout">Keluar</button>
</div>

<section class="card" id="loginCard">
<h2>Login Admin</h2>

<div style="margin-top:16px">
<label>Username</label>
<input id="username" value="Dicky News" autocomplete="username">
</div>

<div style="margin-top:14px">
<label>Password</label>
<input id="password" type="password" autocomplete="current-password">
</div>

<div class="actions">
<button class="primary" id="login">Masuk</button>
</div>

<div class="status" id="loginStatus"></div>
</section>

<section class="card hidden" id="panel">

<div class="service">
<div>
<h2 style="margin:0">Golden HD TikTok</h2>
<div class="sub">Pengaturan layanan utama</div>
</div>
<span class="badge" id="serviceStatus">MEMUAT</span>
</div>

<div class="row" style="margin-top:22px">

<div>
<label>Harga per video (Coin)</label>
<input id="coin" type="number" min="0" step="1">
</div>

<div>
<label>Maksimum ukuran video (MB)</label>
<input id="maxMb" type="number" min="1" step="1">
</div>

</div>

<div class="actions">
<button class="primary" id="save">Simpan Pengaturan</button>
<button class="secondary" id="refresh">Refresh</button>
</div>

<div class="status" id="status"></div>

</section>

</main>

<script>

const API_BASE='http://103.235.74.92';

const $=id=>document.getElementById(id);

async function api(path,opt={}){

const r=await fetch(
API_BASE+path,
{
credentials:'include',
...opt,
headers:{
'Content-Type':'application/json',
...(opt.headers||{})
}
}
);

const d=await r.json().catch(()=>({}));

if(!r.ok)
throw new Error(d.detail||d.message||'Request gagal');

return d;
}

async function load(){

const d=await api('/admin/pricing');

const s=d.services[0];

if(!s)
throw new Error('Service tidak ditemukan');

$('coin').value=s.coin_cost;

$('maxMb').value=
Math.round(
s.max_file_size_bytes/1048576
);

$('serviceStatus').textContent=
s.is_active?'AKTIF':'NONAKTIF';

$('status').textContent=
'Pengaturan terbaru berhasil dimuat.';

$('status').className='status ok';
}

$('login').onclick=async()=>{

try{

await api(
'/admin/login',
{
method:'POST',
body:JSON.stringify({
username:$('username').value,
password:$('password').value
})
}
);

$('loginCard').classList.add('hidden');

$('panel').classList.remove('hidden');

$('logout').classList.remove('hidden');

await load();

}catch(e){

$('loginStatus').textContent=e.message;

$('loginStatus').className='status err';

}

};

$('save').onclick=async()=>{

try{

const d=await api('/admin/pricing');

const s=d.services[0];

await api(
'/admin/pricing/'+s.id,
{
method:'PUT',
body:JSON.stringify({
coin_cost:Number($('coin').value),
max_file_size_bytes:
Number($('maxMb').value)*1048576,
is_active:s.is_active
})
}
);

await load();

$('status').textContent=
'Berhasil disimpan.';

}catch(e){

$('status').textContent=e.message;

$('status').className='status err';

}

};

$('refresh').onclick=()=>{

load().catch(e=>{

$('status').textContent=e.message;

$('status').className='status err';

});

};

$('logout').onclick=async()=>{

try{

await api(
'/admin/logout',
{method:'POST'}
);

}catch{}

location.reload();

};

</script>

</body>
</html>
